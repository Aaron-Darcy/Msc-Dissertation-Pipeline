# Data - never commit raw or cohort-extracted patient data (PhysioNet DUA)
data/
*.csv
*.parquet

# Aggregate result tables are safe to publish: they contain no patient-level data.
!Results/tables/*.csv

# Python
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Credentials
*.env
.env
*service-account*.json
gcp-credentials.json

# Notebook outputs can carry data in cell output - strip before commit if needed

# Editor/workspace files
*.code-workspace
.vscode/
